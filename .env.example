# Copy to .env.local or run npm run setup-local. Never commit real credentials.
DASHBOARD_CITY=Example
DASHBOARD_TIMEZONE=Asia/Shanghai
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
HOST=127.0.0.1
PORT=8787
DASHBOARD_DEVICE_ID=pw4
DASHBOARD_DEVICE_TOKEN=
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_CONTROL_ORIGINS=http://127.0.0.1:8787,http://localhost:8787

# Filled by npm run stage-client-release; this points to a fixed local artifact.
CLIENT_DISTRIBUTION_DIR=
